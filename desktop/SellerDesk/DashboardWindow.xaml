<Window x:Class="SellerDesk.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SellerDesk" Icon="app.ico" Width="1440" Height="900" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="Black"
        FontFamily="pack://application:,,,/Fonts/#Figtree" UseLayoutRounding="True">
    <!-- The dashboard is the page in Web\. This window holds it and answers for it. -->
    <Grid x:Name="Host">
        <StackPanel x:Name="Missing" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Visibility="Collapsed">
            <TextBlock Text="The dashboard needs Microsoft Edge WebView2" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Foreground="#B0B0B6" FontSize="17" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Windows 11 includes it. On this PC it's missing. Install the Evergreen Runtime from Microsoft, then open the dashboard again. Your alarms keep working without it." />
        </StackPanel>
    </Grid>
</Window>
