<Window x:Class="SellerDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SellerDesk settings" Icon="app.ico" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="pack://application:,,,/Fonts/#Hind" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Foreground" Value="{DynamicResource SkinInk}" />
            <Setter Property="Background" Value="{DynamicResource SkinField}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SkinFieldLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SkinLabel}" />
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SkinMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SkinMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="GroupName" Value="part" />
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="0,4,0,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SkinInk}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SkinSignal}" />
                                <Setter Property="Foreground" Value="{DynamicResource SkinInk}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SkinInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource SkinInk}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SkinSignal}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="{DynamicResource SkinCorner}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SkinSignal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource SkinInk}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SkinSignal}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame" CornerRadius="{DynamicResource SkinCorner}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SkinSignal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SkinSignalInk}" />
            <Setter Property="Background" Value="{DynamicResource SkinSignal}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="{DynamicResource SkinCorner}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SkinInk}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" CornerRadius="{DynamicResource SkinCorner}" Background="{DynamicResource SkinField}"
                                BorderBrush="{DynamicResource SkinFieldLine}" BorderThickness="1" Padding="6,9">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource SkinSignal}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SkinSignal}" />
                                <Setter Property="Foreground" Value="{DynamicResource SkinSignalInk}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource SkinInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Bar}" Background="{DynamicResource SkinSignal}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Bar}" Background="{DynamicResource SkinFieldLine}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="22" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource SkinInk}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="24" CornerRadius="{DynamicResource SkinCorner}" Background="{DynamicResource SkinSurface}"
            BorderBrush="{DynamicResource SkinSurfaceLine}" BorderThickness="1"
            Padding="32,24" MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="SellerDesk" Foreground="{DynamicResource SkinInk}" FontSize="36"
                       FontFamily="pack://application:,,,/Fonts/#Big Shoulders" />

            <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="0,4,0,16">
                <RadioButton x:Name="GeneralTab" Style="{StaticResource Tab}" Content="Look and sound" Checked="PartChanged" />
                <RadioButton x:Name="AlarmTab" Style="{StaticResource Tab}" Content="Alarm server" Checked="PartChanged" />
                <RadioButton x:Name="KeyTab" Style="{StaticResource Tab}" Content="Eldorado key" Checked="PartChanged" />
            </StackPanel>

            <!-- The parts share one cell and hide rather than collapse, so the window keeps its height between tabs. -->
            <Grid>
                <StackPanel x:Name="GeneralPart">
                    <TextBlock Text="Theme, applied right away" Foreground="{DynamicResource SkinLabel}" Margin="0,0,0,6" />
                    <UniformGrid x:Name="Themes" Rows="1" Margin="0,0,-8,16" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Foreground="{DynamicResource SkinLabel}" />
                        <TextBlock Text="Alarm volume" Foreground="{DynamicResource SkinLabel}" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Foreground="{DynamicResource SkinInk}" Background="{DynamicResource SkinQuiet}"
                                Padding="14,8" Margin="14,0,0,0" Content="Test sound" Click="TestSound" />
                        <Slider x:Name="VolumeBox" Minimum="5" Maximum="100" SmallChange="5" LargeChange="5" VerticalAlignment="Center"
                                ValueChanged="VolumeChanged" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="AlarmPart">
                    <TextBlock Style="{StaticResource Hint}" Text="Use the same server and topic as your SellerDesk server, so orders reach this PC. For the dashboard alone, clear the topic and fill in Eldorado key." />
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Server address" />
                        <TextBox x:Name="UrlBox" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Topic" />
                        <TextBox x:Name="TopicBox" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Access token" />
                        <PasswordBox x:Name="TokenBox" />
                    </DockPanel>
                    <TextBlock Text="New orders on this PC" Foreground="{DynamicResource SkinLabel}" Margin="0,2,0,6" />
                    <UniformGrid Rows="1" Margin="0,0,-8,0">
                        <RadioButton x:Name="RingOn" Style="{StaticResource Choice}" GroupName="ring" Content="Ring" />
                        <RadioButton x:Name="RingOff" Style="{StaticResource Choice}" GroupName="ring" Content="Stay silent" />
                    </UniformGrid>
                </StackPanel>

                <StackPanel x:Name="KeyPart">
                    <TextBlock Style="{StaticResource Hint}" Text="Create these on the Seller API page of your Eldorado account. Leave both empty if you only want alarms." />
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Client ID" />
                        <TextBox x:Name="SellerIdBox" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Client secret" />
                        <PasswordBox x:Name="SellerSecretBox" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,10" Text="Shared server: your SellerDesk server reads the market once for every PC and keeps the Finance tab. Leave the address empty to read the market from this PC." />
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Server address" />
                        <TextBox x:Name="HubUrlBox" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Server token" />
                        <PasswordBox x:Name="HubTokenBox" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Status" Foreground="{DynamicResource SkinError}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
            <DockPanel LastChildFill="False" Margin="0,16,0,0">
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource Action}" IsDefault="True"
                        Content="Save" Click="Save" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Foreground="{DynamicResource SkinInk}" Background="Transparent"
                        Margin="0,0,6,0" IsCancel="True" Content="Cancel" Click="Cancel" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
