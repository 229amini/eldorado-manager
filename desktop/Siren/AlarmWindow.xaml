<Window x:Class="Siren.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Siren"
        Title="Siren"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="pack://application:,,,/Fonts/#Hind"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Shade lifts the island off a busy game; Glow is the lamp's color spilling under it. Both
             fade in only once the shape rests, because a blur re-renders for each new geometry. -->
        <Path x:Name="Shade" Fill="Black" IsHitTestVisible="False" Opacity="0">
            <Path.Effect>
                <BlurEffect Radius="30" RenderingBias="Performance" />
            </Path.Effect>
        </Path>
        <Path x:Name="Glow" IsHitTestVisible="False" Opacity="0">
            <Path.Effect>
                <BlurEffect Radius="48" RenderingBias="Performance" />
            </Path.Effect>
        </Path>

        <Path x:Name="Body" />

        <Path x:Name="Rim" StrokeThickness="1" IsHitTestVisible="False" Opacity="0">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00FFFFFF" Offset="0.2" />
                    <GradientStop Color="#40FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>

        <!-- The fuse: the island's edge burns down with the time left to deliver. -->
        <Path x:Name="FuseGlow" StrokeThickness="6" IsHitTestVisible="False" Opacity="0">
            <Path.Effect>
                <BlurEffect Radius="10" RenderingBias="Performance" />
            </Path.Effect>
        </Path>
        <Path x:Name="Fuse" StrokeThickness="2.5" StrokeDashCap="Round" IsHitTestVisible="False" Opacity="0" />

        <!-- Island content, clipped to the animated shape. -->
        <Grid x:Name="IslandClip">
            <!-- The compact island: it keeps the clock in view and leaves the rest of your screen alone. -->
            <StackPanel x:Name="Mini" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Height="46" Opacity="0" IsHitTestVisible="False">
                <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse x:Name="MiniDot" />
                    <Ellipse x:Name="MiniLight" />
                </Grid>
                <local:Digits x:Name="MiniClock" Size="30" VerticalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Width="760" Height="104" Opacity="0">
                <Grid Margin="30,14,26,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The lamp that fills the room at the critical stage. -->
                    <Grid Width="26" Height="26" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="DotGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.9" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="LampLight" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Header" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Summary" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <local:Digits x:Name="Countdown" Grid.Column="2" Size="56" VerticalAlignment="Center" Margin="14,0,22,0">
                        <local:Digits.Effect>
                            <DropShadowEffect x:Name="CountdownGlow" BlurRadius="20" ShadowDepth="0" Opacity="0.75" />
                        </local:Digits.Effect>
                    </local:Digits>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenButton" Style="{StaticResource Ghost}" Content="Open" Margin="0,0,8,0" Click="Open" />
                        <Button x:Name="AnswerButton" Style="{StaticResource Pill}" Content="Got it" Click="Answer" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
