# Copy to .env and fill in. docs/configuration.md explains each setting.

# Required. Eldorado > Dashboard > Seller API > Generate credentials.
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=

# Set up at least one channel. docs/channels.md shows how.

# ntfy: push app for Android and iOS, and the source for the Windows alarm
NTFY_URL=
NTFY_TOPIC=eldorado
NTFY_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord
DISCORD_WEBHOOK_URL=

# Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Dashboard. Leave the token empty only while the port stays on localhost.
DASHBOARD_TOKEN=

# Dead-man switch: takes you offline if an alarm goes unanswered. Off by default.
DEADMAN_ENABLED=false
DEADMAN_MINUTES=10
